// ============================================================
// ARCHITECTURE MODULE
// Owner: Architecture Team
// DO NOT modify — Construction module has read-only dependency
// ============================================================

enum ConstructionStatus {
  DONE
  ACTIVE
  PENDING
}

enum DesignStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

model ArchitectureCompany {
  id                    String                  @id @default(uuid())
  name                  String
  createdAt             DateTime                @default(now())
  avatarUrl             String
  awardsWon             Int?
  budgetRangeLabel      String
  city                  String
  clientSatisfactionPct Int?
  country               String                  @default("Sri Lanka")
  coverImageUrl         String
  description           String
  email                 String                  @unique
  locationLabel         String
  projectCount          Int
  rating                Float
  reviewCount           Int
  updatedAt             DateTime
  yearsExperience       Int
  CompanySpecialization CompanySpecialization[]
  FirmService           FirmService[]
  FirmTeamMember        FirmTeamMember[]
  FirmTestimonial       FirmTestimonial[]
  HouseDesign           HouseDesign[]
}

model CompanySpecialization {
  id                  String              @id
  label               String
  companyId           String
  ArchitectureCompany ArchitectureCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ConstructionPhase {
  id             String             @id
  phase          String
  detail         String
  status         ConstructionStatus @default(PENDING)
  sortOrder      Int                @default(0)
  designDetailId String
  DesignDetail   DesignDetail       @relation(fields: [designDetailId], references: [id], onDelete: Cascade)

  @@index([designDetailId])
}

model DesignDetail {
  id                     String               @id
  designId               String               @unique
  breadcrumb             String[]
  architectName          String
  architectFirm          String
  locationLabel          String
  completionYear         Int
  status                 DesignStatus         @default(PLANNING)
  heroImageUrl           String
  threeDVisualizationUrl String?
  priceLkr               Int
  bedrooms               Int
  bathrooms              Int
  sqftArea               Int
  garageSpaces           Int                  @default(0)
  overview               String
  designStyle            String?
  structureType          String?
  interiorFinish         String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime
  ConstructionPhase      ConstructionPhase[]
  HouseDesign            HouseDesign          @relation(fields: [designId], references: [id], onDelete: Cascade)
  DesignFeature          DesignFeature[]
  DesignGalleryImage     DesignGalleryImage[]
  DesignReview           DesignReview?
  FloorPlan              FloorPlan[]
  RelatedProject         RelatedProject[]
}

model DesignFeature {
  id           String       @id
  icon         String
  label        String
  sortOrder    Int          @default(0)
  detailId     String
  DesignDetail DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  @@index([detailId])
}

model DesignGalleryImage {
  id           String       @id
  url          String
  altText      String?
  sortOrder    Int          @default(0)
  detailId     String
  DesignDetail DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  @@index([detailId])
}

model DesignReview {
  id           String       @id
  author       String
  avatarUrl    String
  rating       Int
  text         String
  reviewDate   String
  detailId     String       @unique
  DesignDetail DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)
}

model FirmService {
  id                  String              @id
  icon                String
  title               String
  description         String
  sortOrder           Int                 @default(0)
  companyId           String
  ArchitectureCompany ArchitectureCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FirmTeamMember {
  id                  String              @id
  name                String
  title               String
  photoUrl            String
  sortOrder           Int                 @default(0)
  companyId           String
  ArchitectureCompany ArchitectureCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FirmTestimonial {
  id                  String              @id
  rating              Int
  text                String
  author              String
  role                String
  avatarUrl           String
  createdAt           DateTime            @default(now())
  companyId           String
  ArchitectureCompany ArchitectureCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FloorPlan {
  id           String       @id
  label        String
  imageUrl     String
  sortOrder    Int          @default(0)
  detailId     String
  DesignDetail DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  @@index([detailId])
}

model HouseDesign {
  id                  String              @id
  title               String
  style               String
  priceLkr            Int
  architectName       String
  imageUrl            String
  bedrooms            Int
  bathrooms           Int
  sqftArea            Int
  locationLabel       String
  isSaved             Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  companyId           String
  DesignDetail        DesignDetail?
  ArchitectureCompany ArchitectureCompany @relation(fields: [companyId], references: [id])
  HouseDesignTag      HouseDesignTag[]

  @@index([companyId])
  @@index([priceLkr])
  @@index([style])
}

model HouseDesignTag {
  id          String      @id
  label       String
  designId    String
  HouseDesign HouseDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
}

model RelatedProject {
  id             String       @id
  targetDesignId String
  title          String
  imageUrl       String
  style          String
  priceLkr       Int
  sortOrder      Int          @default(0)
  detailId       String
  DesignDetail   DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  @@index([detailId])
}

// ============================================================
// CONSTRUCTION MODULE — Normalized Relational Schema
// Synced with actual Neon database state via db pull 2026-08-09
// Owner: Construction Team
// ============================================================

enum ConstructionCompanyStatus {
  active
  pending
  suspended
}

// ============================================================
// DISTRICTS
// ============================================================

model ConstructionDistrict {
  id             String                      @id @default(uuid())
  name           String                      @unique
  companies      ConstructionCompany[]
  marketInsights ConstructionMarketInsight[]

  @@map("construction_districts")
}

// ============================================================
// SPECIALIZATIONS
// ============================================================

model ConstructionSpecialization {
  id        String                              @id @default(uuid())
  name      String                              @unique
  icon      String?
  companies ConstructionCompanySpecialization[]

  @@map("construction_specializations")
}

// ============================================================
// CERTIFICATIONS
// ============================================================

model ConstructionCertification {
  id        String                             @id @default(uuid())
  name      String                             @unique
  icon      String?
  companies ConstructionCompanyCertification[]

  @@map("construction_certifications")
}

// ============================================================
// MAIN COMPANY TABLE
// ============================================================

model ConstructionCompany {
  id                    String                    @id(map: "ConstructionCompany_pkey") @default(uuid())
  name                  String
  createdAt             DateTime                  @default(now())
  slug                  String?                   @unique
  tagline               String?
  logoUrl               String?                   @map("logo_url")
  coverImageUrl         String?                   @map("cover_image_url")
  districtId            String?                   @map("district_id")
  isVerified            Boolean                   @default(false) @map("is_verified")
  establishedYear       Int?                      @map("established_year")
  ratingAvg             Decimal                   @default(0) @map("rating_avg") @db.Decimal(2, 1)
  reviewCount           Int                       @default(0) @map("review_count")
  projectsCompleted     Int                       @default(0) @map("projects_completed")
  yearsInBusiness       Int                       @default(0) @map("years_in_business")
  teamSize              Int                       @default(0) @map("team_size")
  avgProjectCost        Decimal?                  @map("avg_project_cost") @db.Decimal(14, 2)
  avgResponseTimeHours  Decimal?                  @map("avg_response_time_hours") @db.Decimal(5, 2)
  clientSatisfactionPct Decimal?                  @map("client_satisfaction_pct") @db.Decimal(5, 2)
  budgetMin             Decimal?                  @map("budget_min") @db.Decimal(14, 2)
  budgetMax             Decimal?                  @map("budget_max") @db.Decimal(14, 2)
  isFeatured            Boolean                   @default(false) @map("is_featured")
  status                ConstructionCompanyStatus @default(active)
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  // Relations
  district        ConstructionDistrict?               @relation(fields: [districtId], references: [id])
  brochures       ConstructionBrochure[]
  certifications  ConstructionCompanyCertification[]
  specializations ConstructionCompanySpecialization[]
  story           ConstructionCompanyStory?
  contact         ConstructionContactInfo?
  projects        ConstructionProject[]
  reviews         ConstructionReview[]
  services        ConstructionService[]

  @@map("construction_companies")
}

// ============================================================
// COMPANY ↔ SPECIALIZATION (many-to-many join)
// ============================================================

model ConstructionCompanySpecialization {
  companyId        String @map("company_id")
  specializationId String @map("specialization_id")

  company        ConstructionCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  specialization ConstructionSpecialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([companyId, specializationId])
  @@map("construction_company_specializations")
}

// ============================================================
// COMPANY ↔ CERTIFICATION (many-to-many join with metadata)
// ============================================================

model ConstructionCompanyCertification {
  companyId       String    @map("company_id")
  certificationId String    @map("certification_id")
  issuedDate      DateTime? @map("issued_date")
  isVerified      Boolean   @default(true) @map("is_verified")

  certification ConstructionCertification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  company       ConstructionCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, certificationId])
  @@map("construction_company_certifications")
}

// ============================================================
// OUR STORY (one-to-one)
// ============================================================

model ConstructionCompanyStory {
  companyId  String  @id @map("company_id")
  ourStory   String? @map("our_story")
  mission    String?
  vision     String?
  coreValues String? @map("core_values")

  company ConstructionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("construction_company_story")
}

// ============================================================
// SERVICES (one-to-many)
// ============================================================

model ConstructionService {
  id           String  @id @default(uuid())
  companyId    String  @map("company_id")
  title        String
  description  String?
  tags         Json?
  displayOrder Int     @default(0) @map("display_order")

  company ConstructionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("construction_services")
}

// ============================================================
// BROCHURES (one-to-many)
// ============================================================

model ConstructionBrochure {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  company ConstructionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("construction_brochures")
}

// ============================================================
// PROJECTS (one-to-many)
// ============================================================

model ConstructionProject {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  title         String
  location      String?
  completedYear Int?     @map("completed_year")
  cost          Decimal? @db.Decimal(14, 2)
  thumbnailUrl  String?  @map("thumbnail_url")
  description   String?
  displayOrder  Int      @default(0) @map("display_order")

  images  ConstructionProjectImage[]
  company ConstructionCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("construction_projects")
}

// ============================================================
// PROJECT IMAGES (one-to-many)
// ============================================================

model ConstructionProjectImage {
  id        String @id @default(uuid())
  projectId String @map("project_id")
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("construction_project_images")
}

// ============================================================
// REVIEWS (one-to-many)
// DB uses Decimal(2,1) for all ratings; overallRating is non-nullable
// ============================================================

model ConstructionReview {
  id           String  @id @default(uuid())
  companyId    String  @map("company_id")
  reviewerName String  @map("reviewer_name")
  reviewerRole String? @map("reviewer_role")

  ratingQuality      Decimal? @map("rating_quality") @db.Decimal(2, 1)
  ratingConstruction Decimal? @map("rating_construction") @db.Decimal(2, 1)
  ratingTimeline     Decimal? @map("rating_timeline") @db.Decimal(2, 1)
  ratingValue        Decimal? @map("rating_value") @db.Decimal(2, 1)
  overallRating      Decimal  @map("overall_rating") @db.Decimal(2, 1)

  reviewText String?   @map("review_text")
  reviewDate DateTime? @map("review_date")
  createdAt  DateTime  @default(now()) @map("created_at")

  company ConstructionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("construction_reviews")
}

// ============================================================
// CONTACT INFORMATION (one-to-one)
// ============================================================

model ConstructionContactInfo {
  companyId     String   @id @map("company_id")
  phone         String?
  email         String?
  website       String?
  address       String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  hoursWeekday  String?  @map("hours_weekday")
  hoursSaturday String?  @map("hours_saturday")
  hoursSunday   String?  @map("hours_sunday")

  company ConstructionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("construction_contact_info")
}

// ============================================================
// MARKET INSIGHTS (per district, per period)
// DB has districtId as optional, monthYear as DateTime?
// ============================================================

model ConstructionMarketInsight {
  id                     String    @id @default(uuid())
  districtId             String?   @map("district_id")
  avgCostPerSqft         Decimal?  @map("avg_cost_per_sqft") @db.Decimal(10, 2)
  residentialCostPerSqft Decimal?  @map("residential_cost_per_sqft") @db.Decimal(10, 2)
  commercialCostPerSqft  Decimal?  @map("commercial_cost_per_sqft") @db.Decimal(10, 2)
  industrialCostPerSqft  Decimal?  @map("industrial_cost_per_sqft") @db.Decimal(10, 2)
  luxuryCostPerSqft      Decimal?  @map("luxury_cost_per_sqft") @db.Decimal(10, 2)
  monthYear              DateTime? @map("month_year")

  district ConstructionDistrict? @relation(fields: [districtId], references: [id])

  @@map("construction_market_insights")
}

model Land {
  id              String   @id @default(uuid())
  name            String
  description     String
  location        String
  status          String
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  price           Float
  perches         Float
  sqft            Float?
  images          String[]
  landType        String
  matchScore      Int?
  developmentPlan String?
  environment     String?
  purpose         String?
}

model Property {
  id               String   @id @default(uuid())
  title            String
  createdAt        DateTime @default(now())
  description      String?
  price            Float
  location         String
  bedrooms         Int
  bathrooms        Int
  area             Float
  propertyType     String
  listingType      String
  images           String[]
  matchScore       Int?
  latitude         Float?
  longitude        Float?
  updatedAt        DateTime @updatedAt
  hasGarden        Boolean  @default(false)
  hasModernKitchen Boolean  @default(false)
  hasPool          Boolean  @default(false)
  hasSeaView       Boolean  @default(false)
  hasSecurity      Boolean  @default(false)
  isCityCenter     Boolean  @default(false)
  isCoastal        Boolean  @default(false)
  isInvestment     Boolean  @default(false)
  isNearBeach      Boolean  @default(false)
  isNearHighway    Boolean  @default(false)
  isNearHospital   Boolean  @default(false)
  isNearSchools    Boolean  @default(false)
  isOwnHome        Boolean  @default(false)
  isQuietArea      Boolean  @default(false)
  isRentalIncome   Boolean  @default(false)
  isRural          Boolean  @default(false)
  isSuburban       Boolean  @default(false)
  isUrban          Boolean  @default(false)
  isVacationHome   Boolean  @default(false)
  parkingSpaces    Int      @default(0)
}

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

generator clientDefault {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  AGENT
  ARCHITECT
  CONTRACTOR
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  createdAt  DateTime @default(now())
  avatar     String?
  firstName  String?
  isVerified Boolean  @default(false)
  lastName   String?
  password   String
  phone      String?
  role       Role     @default(USER)
  updatedAt  DateTime
}
