model ArchitectureCompany {
  id                    String                  @id @default(uuid())
  name                  String
  createdAt             DateTime                @default(now())
  avatarUrl             String
  awardsWon             Int?
  budgetRangeLabel      String
  city                  String
  clientSatisfactionPct Int?
  country               String                  @default("Sri Lanka")
  coverImageUrl         String
  description           String
  email                 String                  @unique
  locationLabel         String
  projectCount          Int
  rating                Float
  reviewCount           Int
  updatedAt             DateTime                @updatedAt
  yearsExperience       Int
  specializations       CompanySpecialization[]
  services              FirmService[]
  teamMembers           FirmTeamMember[]
  testimonials          FirmTestimonial[]
  houseDesigns          HouseDesign[]
}

model CompanySpecialization {
  id        String              @id @default(uuid())
  label     String
  companyId String
  company   ArchitectureCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FirmService {
  id          String              @id @default(uuid())
  icon        String
  title       String
  description String
  sortOrder   Int                 @default(0)
  companyId   String
  company     ArchitectureCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FirmTeamMember {
  id        String              @id @default(uuid())
  name      String
  title     String
  photoUrl  String
  sortOrder Int                 @default(0)
  companyId String
  company   ArchitectureCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FirmTestimonial {
  id        String              @id @default(uuid())
  rating    Int
  text      String
  author    String
  role      String
  avatarUrl String
  createdAt DateTime            @default(now())
  companyId String
  company   ArchitectureCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model HouseDesign {
  id            String              @id @default(uuid())
  title         String
  style         String
  priceLkr      Int
  architectName String
  imageUrl      String
  bedrooms      Int
  bathrooms     Int
  sqftArea      Int
  locationLabel String
  isSaved       Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  companyId     String
  detail        DesignDetail?
  company       ArchitectureCompany @relation(fields: [companyId], references: [id])
  tags          HouseDesignTag[]

  @@index([companyId])
  @@index([style])
  @@index([priceLkr])
}

model HouseDesignTag {
  id       String      @id @default(uuid())
  label    String
  designId String
  design   HouseDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
}

model DesignDetail {
  id                     String               @id @default(uuid())
  designId               String               @unique
  breadcrumb             String[]
  architectName          String
  architectFirm          String
  locationLabel          String
  completionYear         Int
  status                 DesignStatus         @default(PLANNING)
  heroImageUrl           String
  threeDVisualizationUrl String?
  priceLkr               Int
  bedrooms               Int
  bathrooms              Int
  sqftArea               Int
  garageSpaces           Int                  @default(0)
  overview               String
  designStyle            String?
  structureType          String?
  interiorFinish         String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  constructionProgress   ConstructionPhase[]
  design                 HouseDesign          @relation(fields: [designId], references: [id], onDelete: Cascade)
  features               DesignFeature[]
  gallery                DesignGalleryImage[]
  review                 DesignReview?
  floorPlans             FloorPlan[]
  relatedProjects        RelatedProject[]
}

model DesignGalleryImage {
  id        String       @id @default(uuid())
  url       String
  altText   String?
  sortOrder Int          @default(0)
  detailId  String
  detail    DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  @@index([detailId])
}

model FloorPlan {
  id        String       @id @default(uuid())
  label     String
  imageUrl  String
  sortOrder Int          @default(0)
  detailId  String
  detail    DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  @@index([detailId])
}

model DesignFeature {
  id        String       @id @default(uuid())
  icon      String
  label     String
  sortOrder Int          @default(0)
  detailId  String
  detail    DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  @@index([detailId])
}

model ConstructionPhase {
  id             String             @id @default(uuid())
  phase          String
  detail         String
  status         ConstructionStatus @default(PENDING)
  sortOrder      Int                @default(0)
  designDetailId String
  designDetail   DesignDetail       @relation(fields: [designDetailId], references: [id], onDelete: Cascade)

  @@index([designDetailId])
}

model DesignReview {
  id         String       @id @default(uuid())
  author     String
  avatarUrl  String
  rating     Int
  text       String
  reviewDate String
  detailId   String       @unique
  detail     DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)
}

model RelatedProject {
  id             String       @id @default(uuid())
  targetDesignId String
  title          String
  imageUrl       String
  style          String
  priceLkr       Int
  sortOrder      Int          @default(0)
  detailId       String
  detail         DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  @@index([detailId])
}

enum DesignStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

enum ConstructionStatus {
  DONE
  ACTIVE
  PENDING
}
