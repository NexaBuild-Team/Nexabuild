// ============================================================
// ARCHITECTURE MODULE
// Owner: Architecture Team
// DO NOT modify — Construction module has read-only dependency
// ============================================================

enum ConstructionStatus {
  DONE
  ACTIVE
  PENDING
}

enum DesignStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

model ArchitectureCompany {
  id                    String                  @id @default(uuid())
  name                  String
  createdAt             DateTime                @default(now())
  avatarUrl             String
  awardsWon             Int?
  budgetRangeLabel      String
  city                  String
  clientSatisfactionPct Int?
  country               String                  @default("Sri Lanka")
  coverImageUrl         String
  description           String
  email                 String                  @unique
  locationLabel         String
  projectCount          Int
  rating                Float
  reviewCount           Int
  updatedAt             DateTime
  yearsExperience       Int
  CompanySpecialization CompanySpecialization[]
  FirmService           FirmService[]
  FirmTeamMember        FirmTeamMember[]
  FirmTestimonial       FirmTestimonial[]
  HouseDesign           HouseDesign[]
}

model CompanySpecialization {
  id                  String              @id
  label               String
  companyId           String
  ArchitectureCompany ArchitectureCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ConstructionPhase {
  id             String             @id
  phase          String
  detail         String
  status         ConstructionStatus @default(PENDING)
  sortOrder      Int                @default(0)
  designDetailId String
  DesignDetail   DesignDetail       @relation(fields: [designDetailId], references: [id], onDelete: Cascade)

  @@index([designDetailId])
}

model DesignDetail {
  id                     String               @id
  designId               String               @unique
  breadcrumb             String[]
  architectName          String
  architectFirm          String
  locationLabel          String
  completionYear         Int
  status                 DesignStatus         @default(PLANNING)
  heroImageUrl           String
  threeDVisualizationUrl String?
  priceLkr               Int
  bedrooms               Int
  bathrooms              Int
  sqftArea               Int
  garageSpaces           Int                  @default(0)
  overview               String
  designStyle            String?
  structureType          String?
  interiorFinish         String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime
  ConstructionPhase      ConstructionPhase[]
  HouseDesign            HouseDesign          @relation(fields: [designId], references: [id], onDelete: Cascade)
  DesignFeature          DesignFeature[]
  DesignGalleryImage     DesignGalleryImage[]
  DesignReview           DesignReview?
  FloorPlan              FloorPlan[]
  RelatedProject         RelatedProject[]
}

model DesignFeature {
  id           String       @id
  icon         String
  label        String
  sortOrder    Int          @default(0)
  detailId     String
  DesignDetail DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  @@index([detailId])
}

model DesignGalleryImage {
  id           String       @id
  url          String
  altText      String?
  sortOrder    Int          @default(0)
  detailId     String
  DesignDetail DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  @@index([detailId])
}

model DesignReview {
  id           String       @id
  author       String
  avatarUrl    String
  rating       Int
  text         String
  reviewDate   String
  detailId     String       @unique
  DesignDetail DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)
}

model FirmService {
  id                  String              @id
  icon                String
  title               String
  description         String
  sortOrder           Int                 @default(0)
  companyId           String
  ArchitectureCompany ArchitectureCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FirmTeamMember {
  id                  String              @id
  name                String
  title               String
  photoUrl            String
  sortOrder           Int                 @default(0)
  companyId           String
  ArchitectureCompany ArchitectureCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FirmTestimonial {
  id                  String              @id
  rating              Int
  text                String
  author              String
  role                String
  avatarUrl           String
  createdAt           DateTime            @default(now())
  companyId           String
  ArchitectureCompany ArchitectureCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FloorPlan {
  id           String       @id
  label        String
  imageUrl     String
  sortOrder    Int          @default(0)
  detailId     String
  DesignDetail DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  @@index([detailId])
}

model HouseDesign {
  id                  String              @id
  title               String
  style               String
  priceLkr            Int
  architectName       String
  imageUrl            String
  bedrooms            Int
  bathrooms           Int
  sqftArea            Int
  locationLabel       String
  isSaved             Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  companyId           String
  DesignDetail        DesignDetail?
  ArchitectureCompany ArchitectureCompany @relation(fields: [companyId], references: [id])
  HouseDesignTag      HouseDesignTag[]

  @@index([companyId])
  @@index([priceLkr])
  @@index([style])
}

model HouseDesignTag {
  id          String      @id
  label       String
  designId    String
  HouseDesign HouseDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
}

model RelatedProject {
  id             String       @id
  targetDesignId String
  title          String
  imageUrl       String
  style          String
  priceLkr       Int
  sortOrder      Int          @default(0)
  detailId       String
  DesignDetail   DesignDetail @relation(fields: [detailId], references: [id], onDelete: Cascade)

  @@index([detailId])
}
