model Land {
  id                String   @id @default(uuid())
  name              String
  description       String
  price             String
  location          String
  perches           String
  sqft              String?
  status            String
  badge             String?
  landType          String
  img               String
  latitude          Float?
  longitude         Float?
  zoning            String?
  roadAccess        Boolean  @default(false)
  waterAccess       Boolean  @default(false)
  electricityAccess Boolean  @default(false)
  investmentScore   Int      @default(0)
  matchScore        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime
}
