model Land {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Float
  location    String
  perches     Float
  sqft        Float?
  status      String
  landType    String // e.g. "Residential", "Commercial", "Agricultural"

  purpose         String?
  environment     String?
  developmentPlan String?

  images String[] // array of Cloudinary URLs

  matchScore Int? // AI recommendation score (0-100)

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
