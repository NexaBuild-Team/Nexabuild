model Land {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  location    String
  perches     Float
  sqft        Float?
  landType    String?
  latitude    Float?
  longitude   Float?
  status      String
  images      String
  matchScore  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
