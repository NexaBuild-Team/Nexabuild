model Land {
  id                String   @id @default(cuid())
  name              String
  description       String
  price             Float
  location          String
  province          String
  pricePerPerch     Float
  perches           Float
  sqft              Float?
  type              String
  zoning            String?
  roadFrontage      String
  utilities         String
  shape             String
  facing            String
  terrain           String
  titleType         String
  latitude          Float?
  longitude         Float?
  mapImg            String?
  status            String
  img               String
  imgMain           String
  imgSec            String
  allImages         String[]
  highlights        String[]
  reasons           String[]
  badges            String[]
  rank              Int?

  schools           Json?
  hospitals         Json?
  supermarkets      Json?
  agent             Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}