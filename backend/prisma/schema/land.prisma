model Land {
  id              String   @id @default(uuid())
  name            String
  description     String
  location        String
  status          String
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  price           Float
  perches         Float
  sqft            Float?
  images          String[]
  landType        String
  matchScore      Int?
  developmentPlan String?
  environment     String?
  purpose         String?
  views           Int      @default(0)
  savedLands SavedLand[]
}
