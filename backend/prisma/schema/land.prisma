model Land {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  location    String
  perches     Float
  sqft        Float?
  landType    String?
  latitude    Float?
  longitude   Float?
  status      String

  landType    String // e.g. "Residential", "Commercial", "Agricultural"

  purpose         String?
  environment     String?
  developmentPlan String?

  images String[] // array of Cloudinary URLs

  matchScore Int? // AI recommendation score (0-100)

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images      String
  matchScore  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

}
