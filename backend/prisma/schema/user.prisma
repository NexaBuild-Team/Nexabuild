enum Role {
  USER
  ADMIN
  AGENT
  ARCHITECT
  CONTRACTOR
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  createdAt  DateTime @default(now())
  avatar     String?
  firstName  String?
  isVerified Boolean  @default(false)
  lastName   String?
  password   String
  phone      String?
  role       Role     @default(USER)
  updatedAt  DateTime
}
