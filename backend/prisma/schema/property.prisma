model Property {
  id          String   @id @default(uuid())
  title       String
  description String?
  price       Float
  location    String
  bedrooms    Int
  bathrooms   Int
  area        Float
  propertyType String   // e.g. "House", "Apartment", "Villa"
  listingType String    // "Buy", "Rent", "Sell"

  images      String[]  // array of Cloudinary URLs

  matchScore     Int?     // AI recommendation score (0-100)
  investmentScore Int?    // AI investment potential score

  latitude    Float?
  longitude   Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}